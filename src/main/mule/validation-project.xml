	<flow name="Is_URL" doc:id="4ee8c79f-1818-4778-8ad6-9a301a4d5dac" >
		<http:listener doc:name="Listener" doc:id="472be96e-f9a9-4e80-8fdd-3298d5b5b844" config-ref="HTTP_Listener_config" path="/url"/>
		<validation:is-url doc:name="Is URL" doc:id="47fe7a55-1300-485d-907d-7d1237bd9665" config-ref="Validation_Config1" url="#[payload.url]"/>
		<ee:transform doc:name="Transform Message" doc:id="0eff6442-e5d8-4e77-993f-9a996b223a4d" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
