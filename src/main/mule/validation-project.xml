	<flow name="Is_empty_collection" doc:id="d3bd8ab6-0192-4eef-88d4-cd27eb5f0247" >
		<http:listener doc:name="Listener" doc:id="e6158c57-aca6-41c4-81c6-213ee2f45601" config-ref="HTTP_Listener_config" path="/isEmptyCollection"/>
		<validation:is-empty-collection doc:name="Is_empty_collection" doc:id="fe2b19f0-280d-4960-944b-04b3ec539f37" values="#[payload.collection]" config-ref="Validation_Config4"/>
	</flow>
	<flow name="Is_number" doc:id="cdc4e94b-9a75-4904-b56f-dc5d6b871bf6">
		<http:listener doc:name="Listener" doc:id="ae6a0a49-8a3a-454b-b8fa-beb7ee900021" config-ref="HTTP_Listener_config" path="/isNumber" />
		<validation:is-number numberType="INTEGER" doc:name="Is_number" doc:id="c7a7917b-6cb5-4ec6-b74f-da6f1dc3e7e3" config-ref="Validation_Config5" value="age" minValue="18" maxValue="56"/>
	</flow>
	<flow name="Is_time" doc:id="4ca03b09-faae-4e77-b212-5a3ab62900d5">
		<http:listener doc:name="Listener" doc:id="bf31f33f-b683-46ab-a21c-1a96d89ce0b3" config-ref="HTTP_Listener_config" path="/isTime" />
		<validation:is-time doc:name="Is_time" doc:id="466fe052-d029-47da-a840-18c0c39f0b8a" config-ref="Validation_Config6" time="#[payload.time]" pattern="HH:MM:SS" />
	</flow>
	<flow name="Validate_size" doc:id="034b1a52-d966-479b-901c-64607af581ee" >
		<http:listener doc:name="Listener" doc:id="d0f7a2de-fd62-4d5e-bde4-2fa54d0b010c" config-ref="HTTP_Listener_config" path="/size"/>
		<validation:validate-size doc:name="Validate_size" doc:id="a2427797-c9b6-4e71-a0f7-99f9b626d4e6" config-ref="Validation_Config7" value="payload.description" min="10" max="30"/>
	</flow>
	<flow name="Is_allowed_ip" doc:id="4a730983-4dbe-4885-9e72-c2869b14172d" >
		<http:listener doc:name="Listener" doc:id="6e50aa08-d7f4-43df-a116-6a8106e4a577" config-ref="HTTP_Listener_config" path="/allowIP"/>
		<validation:is-allowed-ip doc:name="Is_allowed_ip" doc:id="f57bb025-a1ea-48b2-981e-17dab100f39f" config-ref="Validation_Config8" ipAddress="#[payload.ip]" allowList='#["2001:0db8:85a3:0000:0000:8a2e:0370:7334"]'/>
	</flow>
	<flow name="Matches_regex" doc:id="78b1213c-dc7f-4827-a7cd-f18e630b588c" >
		<http:listener doc:name="Listener" doc:id="fed77860-6ae2-4d89-b2e0-bfbd18bbaeec" config-ref="HTTP_Listener_config" path="/matchesRegex"/>
		<validation:matches-regex doc:name="Matches_regex" doc:id="ac57e631-fbfd-435e-b419-c55fc2954059" value="#[payload.employeeId]" regex="^[A-Za-z]{3}(\d){7}$                         "/>
	</flow>
	<flow name="Is_blank_string" doc:id="d2be8725-b3e7-4938-aaae-28475e6ddd7f" >
		<http:listener doc:name="Listener" doc:id="424df70f-c620-4fb6-b3f3-64c7dfbeda5e" config-ref="HTTP_Listener_config" path="/isBlank"/>
		<validation:is-blank-string doc:name="Is_blank_string" doc:id="a9446dfb-66df-4b68-927f-54a15a20de5f" value="#[payload.des]"/>
	</flow>
	<flow name="validation-projectFlow1" doc:id="f7ec6390-d495-4fca-b039-9f0a446fd6f3" >
		<validation:is-not-empty-collection doc:name="Is not empty collection" doc:id="9fea3a46-459a-4414-8dae-f9b1c3b4d2a2" />
	</flow>
	<flow name="Is_elapsed" doc:id="f3fdf9e0-e498-4310-adf7-e2a869c78bd0" >
		<http:listener doc:name="Listener" doc:id="bcef793a-b855-47a2-a4cc-7c81b5916c14" config-ref="HTTP_Listener_config" path="/isEleapsed"/>
		<validation:is-elapsed time="1" timeUnit="MINUTES" doc:name="Is_elapsed" doc:id="b71ce6bc-970a-488d-9028-6675102df5e7" config-ref="Validation_Config11" since="0"/>
	</flow>
	<flow name="Is_true" doc:id="8f4db62f-7810-4396-a944-a118ed5b4bcd" >
		<http:listener doc:name="Listener" doc:id="a0a783d5-112e-4bfe-b42b-4eb002aaa4bd" config-ref="HTTP_Listener_config" path="/istrue"/>
		<validation:is-true doc:name="Is_true" doc:id="7db63ff2-faed-41af-9d0b-468527df4f7a" config-ref="Validation_Config12"/>
	</flow>
	<flow name="validation-projectFlow2" doc:id="8399ed0b-18b0-47d1-b3d6-a292406c642f" >
		<http:listener doc:name="Listener" doc:id="2a5c70a4-3d21-432f-b8ad-fcdcb3c47d51" config-ref="HTTP_Listener_config" path="/isEmail"/>
		<validation:is-email doc:name="Is email" doc:id="6fe9aa3c-c9e3-4890-8c5d-d73e88442d72" config-ref="Validation_Config13" email="#[payload.email]" />
	</flow>
	<flow name="validation-projectFlow" doc:id="1ddd40ab-7d30-4f2d-ba3a-91a0a9bdcb9b" >
		<http:listener doc:name="Listener" doc:id="03aa695d-d3ea-47b6-8fdb-bc11a1406db6" config-ref="HTTP_Listener_config" path="/elapsed"/>
		<validation:is-not-elapsed time='#[20]' doc:name="Is not elapsed" doc:id="2cdf41bd-d430-4691-8067-8708503aba3a" config-ref="Validation_Config14" timeUnit="SECONDS" since="#[(payload.otpGeneratedAt as DateTime) as LocalDateTime]"/>
			<choice doc:name="Choice" doc:id="4684286b-0f68-434a-a025-4f52542c275f" >
			<when expression="#[isEmpty(payload)]">
				<ee:transform doc:name="Transform Message" doc:id="c6eadab1-e5f5-4c21-9de8-0c2de7e149d3" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Success"]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise >
				<ee:transform doc:name="Transform Message" doc:id="1c0019e2-e33c-40c1-8198-0d3fcc98480c" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
"Fail"]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
		<logger level="INFO" doc:name="Logger" doc:id="d1e95ed6-df12-4db5-94fd-d687ee0c2989" message="#[payload]" category="AFTER IS NOT=================================================&gt;"/>
					<logger level="INFO" doc:name="Logger" doc:id="d1e95ed6-df12-4db5-94fd-d687ee0c2989" message="#[payload]" category="AFTER IS NOT the Prasanna=================================================&gt;"/>

	</flow>
